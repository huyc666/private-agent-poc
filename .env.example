# ============ LLM ============
# true = Mock 模式（无需 GPU，先验证链路）；false = 连接真实模型
MOCK_LLM=true

# ---- 方案 A：私有化 vLLM（生产）----
# vLLM OpenAI 兼容接口地址（docker compose 里的 vllm 服务）
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY

# vLLM 启动时 --served-model-name 的名字
MODEL_NAME=qwen-27b

# ---- 方案 B：DeepSeek 云端（无 GPU 机器的临时开发方案）----
# 注意：数据会发送到 DeepSeek 云端，仅用于开发联调，正式私有化部署请切回方案 A
# MOCK_LLM=false
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-你的密钥
# MODEL_NAME=deepseek-chat        # 或 deepseek-reasoner（R1 推理模型）
TEMPERATURE=0.7
MAX_TOKENS=2048

# ============ MCP 工具 ============
MCP_ENABLED=true

# 内置工具 read_text_file 的访问边界（默认项目根目录）
# TOOL_WORKSPACE=D:/data/agent-workspace

# ============ Skills 与自定义工具目录 ============
# SKILLS_DIR=./skills
# CUSTOM_TOOLS_DIR=./custom_tools
# CUSTOM_TOOLS_EXEC=auto    # auto|sandbox|local：auto=沙箱优先，不可达回退本地

# ============ Token 计量（v0.11.0 起）============
# 按 用户/任务(单次运行)/会话 三维度记录每次模型调用的 token 消耗，
# SQLite 存储零依赖；查询：GET /api/usage?user_id=&session_id=&days=7
# USAGE_DB=./usage.db

# ---- 会话与审批持久化（P2 无状态化，v0.13.0）----
# 对话记录与审批记录共用的 SQLite 库；同机多进程可共享，跨机须换 Postgres
# STATE_DB=./state.db
# 会话历史读取条数上限（展示侧）
# SESSION_MAX_HISTORY=20

# ---- 包可信签名（v0.13.0）----
# 配置后进入强制信任模式：只有带有效 HMAC 签名的包才加载（未签名/篡改 → 整包不可用）。
# 生成密钥：python -c "import secrets; print(secrets.token_hex(32))"
# 签名现有包：python tools/sign_pack.py --all
# PACK_SIGNING_KEY=

# ---- API 认证与多用户（v0.14.0，设计见 AUTH_DESIGN.md）----
# false（默认）= 开放模式（POC 演示）；true = Bearer API Key 认证：
# 所有 /api/* 须持有效 Key（pak- 前缀），user_id 以服务端解析为准（计量归属可信），
# 审批决议按角色控制（user 只能决议自己创建的；approver/admin 可决议任何）。
# 用户管理：python tools/manage_users.py add <用户名> --role approver / revoke / list
# AUTH_ENABLED=false
# 认证模式首次启动且用户表为空时，以此为用户名创建 admin 并打印一次性 Key
# AUTH_BOOTSTRAP_ADMIN=admin
# 账号密码登录（v0.15.0）：manage_users.py passwd <用户名> 设置密码后，
# 前端可用账号密码登录（签发 pat- 短期令牌）；也可用 API Key 直接进入。
# AUTH_TOKEN_TTL_HOURS=12   # 登录令牌有效期（小时）
# SSO 钩子（v0.16.0）：反向代理身份头模式。Agent 位于受信企业网关之后时，
# 配置身份头名（如 X-Forwarded-User），网关完成企业登录后注入该头；
# 角色仍查本地用户表（认证在外、授权在内），用户不存在一律 401。
# ⚠️ v0.17.4（安全审计 F2）：必须同时配置 AUTH_PROXY_ALLOWED_IPS 受信代理
# 白名单，身份头才生效——否则 fail-closed 一律忽略（任何人直连端口都无法
# 伪造身份头冒充他人）。代理仍需剥离客户端自报的同名头。
# AUTH_IDENTITY_HEADER=X-Forwarded-User
# AUTH_PROXY_ALLOWED_IPS=127.0.0.1,10.0.0.0/8   # 受信代理来源 IP/CIDR，逗号分隔

# ============ 领域包（Domain Pack，v0.8.0 起）============
# 通用内核 + 可插拔领域能力：每个包 = packs/<名称>/ 目录
# （pack.yaml 清单 + tools/ 工具 + skills/ 技能 + prompt.md 提示词）
# 禁用某包后其工具/技能/提示词即从 Agent 消失，可整体替换；天气能力
# （get_current_weather + weather-report 技能）就是第一个示例包 weather-ops
# PACKS_DIR=./packs
# ENABLED_PACKS=            # 逗号分隔白名单；留空 = 加载全部可用包
# 聊天中可对 Agent 说「禁用/启用 xxx 包」（危险操作，需审批，运行时内存态）

# ============ Checkpointer 持久化（会话/审批现场，重启不丢）============
# 默认 memory（进程内存）。生产建议 postgres（仅 Linux/macOS 部署支持）：
# 先 docker compose -f docker-compose.postgres.yml up -d，再：
# CHECKPOINTER=postgres
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agent_poc

# ============ 天气工具（多数据源降级链）============
# 主源 Open-Meteo（免费无需 key，支持全球城市）；不可达时自动降级到
# itboy 免费天气（覆盖国内区县，无需 key）。内网离线环境可改为内部代理/网关地址：
# WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_TIMEOUT=10
# WEATHER_ITBOY_ENABLED=true
# WEATHER_ITBOY_CITY_URL=https://j.i8tq.com/weather2020/search/city.js
# WEATHER_ITBOY_API_URL=http://t.weather.itboy.net/api/weather/city/{code}

# ============ Langfuse 调用链观测 ============
# 默认关闭。先 docker compose -f docker-compose.langfuse.yml up -d 起观测栈，
# 再改为 true 并重启 Agent 服务。服务器不可达时自动停用，不影响聊天。
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
# 与 docker-compose.langfuse.yml 中 LANGFUSE_INIT_* 配置的一致
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# ============ 代码执行沙箱 ============
# 未配置时 run_python_code 工具拒绝执行（fail-closed）。
# 部署：docker compose -f docker-compose.sandbox.yml up -d
# SANDBOX_URL=http://127.0.0.1:9001
# SANDBOX_TIMEOUT=20
# 沙箱共享令牌（安全加固）：与 compose 的 SANDBOX_AUTH_TOKEN 配同一个值才启用鉴权。
# 生产建议生成随机值：python -c "import secrets; print(secrets.token_hex(32))"
# SANDBOX_AUTH_TOKEN=
# v0.17.4（安全审计 F3）：未配置令牌时沙箱默认拒绝执行（fail-closed）；
# 仅兼容存量未鉴权部署可显式放开（不推荐，见 docker-compose.sandbox.yml）
# SANDBOX_OPEN_MODE=false

# ============ Skills 技能系统 ============
# 技能 = skills/<名称>/SKILL.md（name + description + Markdown 指令）
# 聊天中可直接说「创建一个技能」由 Agent 制作；任务匹配时模型自动加载使用
# SKILLS_DIR=./skills

# SYSTEM_PROMPT=你是……
